section.auth-card
  p.auth__kicker Staff desk
  h1.auth-card__title Reset password
  p.auth-card__dek We will send reset instructions to your email.
  - if notice
    p.auth-card__ok = notice
  - if alert
    p.auth-card__bad = alert
  = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: 'auth-form' }) do |f|
    label.auth-form__field
      span Email
      = f.email_field :email, autofocus: true, autocomplete: 'email', required: true
    = f.submit 'Send reset link', class: 'auth-form__btn'
  p.auth-card__links
    = link_to 'Back to sign in', new_session_path(resource_name)
