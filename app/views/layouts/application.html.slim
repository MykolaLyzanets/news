doctype html
html lang="#{I18n.locale}"
  head
    = display_meta_tags page_meta_tags
    - if article_page?
      script type="application/ld+json"
        == news_article_jsonld(@post)

    link rel="preconnect" href="https://fonts.googleapis.com"
    link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""
    link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;0,800;0,900;1,400;1,700&display=swap" rel="stylesheet"
    = stylesheet_link_tag "application.min", "data-turbo-track": "reload"
    = javascript_include_tag "application", "data-turbo-track": "reload", defer: true
    = csrf_meta_tags
    = csp_meta_tag

  body
    #flash
      = render 'layouts/flash'
    .site
      = render 'layouts/header'
      main
        = yield
      = render 'layouts/footer'
