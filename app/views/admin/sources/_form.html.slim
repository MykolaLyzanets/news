= form_with model: [:admin, source], class: 'admin__form' do |f|
  - if source.errors.any?
    ul.admin__bad
      - source.errors.full_messages.each do |msg|
        li = msg
  label
    span Name
    = f.text_field :name
  label
    span Country
    = f.text_field :country
  label
    span Site URL
    = f.text_field :url
  label
    span Feed URL
    = f.text_field :feed_url
  label
    span Category
    = f.collection_select :category_id, Category.ordered, :id, :name
  label
    span Parser
    = f.select :parser_type, Source::PARSER_TYPES
  label
    span Language
    = f.text_field :language
  label
    span Priority
    = f.number_field :priority
  label.admin__check
    = f.check_box :active
    span Active
  = f.submit 'Save', class: 'admin__btn'
